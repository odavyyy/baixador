{
  "name": "baixador",
  "productName": "Baixador",
  "version": "1.4.0",
  "description": "App simples para Windows que baixa vídeo e áudio com yt-dlp e FFmpeg.",
  "license": "MIT",
  "author": "odavyyy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odavyyy/baixador.git"
  },
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:convert": "node scripts/run-test.mjs tests/convert-engine.ts",
    "test:updater": "node scripts/run-test.mjs tests/updater.ts",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "notices": "node scripts/notices.mjs",
    "art": "electron scripts/render-art.cjs"
  },
  "build": {
    "appId": "local.baixador.app",
    "productName": "Baixador",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "PRIVACY.md",
      "TERMS.md",
      "CONTENT_NOTICE.md",
      "CODE_SIGNING_POLICY.md"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Baixador",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "asar": true,
    "compression": "normal",
    "artifactName": "${productName}-${version}-win-${arch}.${ext}",
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
